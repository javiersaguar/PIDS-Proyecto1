{
  "uid": "pids-mongo",
  "title": "PIDS · MongoDB",
  "tags": [
    "pids"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Otros cuadros de PIDS",
      "type": "dashboards",
      "icon": "dashboard",
      "tags": [
        "pids"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Qué hay guardado",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "text",
      "title": "Solo agregados",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "mode": "markdown",
        "content": "MongoDB guarda totales con **k = 10** (base `publico`) y la auditoría. Los viajes de cada persona están en el bucket S3 `crudo`, no aquí. `historico` es 2020; `tiempo_real` es lo que Spark acaba de publicar."
      },
      "transparent": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Documentos publicados",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (coleccion) (publico_documentos))",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "max entre las dos réplicas: las dos publican el mismo inventario."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tamaño de los agregados",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (coleccion) (publico_datos_bytes))",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },

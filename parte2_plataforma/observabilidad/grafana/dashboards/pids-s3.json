      "type": "stat",
      "title": "Volúmenes escribibles",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(SeaweedFS_master_volume_layout_writable)",
          "instant": true

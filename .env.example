# Plantilla de configuración. No edites esto a mano: `make entorno` genera .env con claves aleatorias.
# .env no se sube nunca al repositorio.

# --- S3 (SeaweedFS): una identidad por componente ---
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
S3_SPARK_ACCESS_KEY=
S3_SPARK_SECRET_KEY=
S3_INGESTA_ACCESS_KEY=
S3_INGESTA_SECRET_KEY=

# --- MongoDB ---
MONGO_ROOT_USER=pids_admin
MONGO_ROOT_PASSWORD=
MONGO_SPARK_PASSWORD=
MONGO_ACCESO_PASSWORD=
MONGO_AUDITOR_PASSWORD=

# --- Claves de las APIs (cabecera X-API-Key) ---
CAPTURA_CLAVE_SIMULADOR=
CAPTURA_CLAVE_GESTOS=
CAPTURA_CLAVE_CHATBOT=
ACCESO_CLAVE_CHATBOT=
ACCESO_CLAVE_CHATBOT_RAG=
ACCESO_CLAVE_AIRFLOW=
ACCESO_CLAVE_EQUIPO=

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# --- Grafana (usuario admin) ---
GRAFANA_ADMIN_PASSWORD=

# --- Chatbot (Ollama, LLM local) ---
# llama3.1:8b necesita GPU; en CPU usa llama3.2:3b
OLLAMA_MODELO=llama3.1:8b
GESTOS_ACTIVOS=false
# Login de los dos chatbots de Chainlit (http://localhost:8010 y :8011)
CHATBOT_USUARIO=equipo
CHATBOT_CLAVE=
CHAINLIT_AUTH_SECRET=

# --- Chatbot RAG (LLM externo compatible con OpenAI: Mistral, infraestructura UE) ---
# LLM_API_KEY se pega con `make rag-clave` (console.mistral.ai → API Keys; el plan gratuito basta); `make entorno`
# la deja vacía. Solo se admiten los proveedores y modelos de parte3_chatbot_rag/llm.py (los que no salen de la UE).
# Helmcode sigue admitido: LLM_BASE_URL=https://api.helmcode.com/v1, deepseek-v4-flash y qwen3-embedding, y
# `make rag-indexar ARGS=--recrear` (sus embeddings tienen otra dimensión).
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODELO=ministral-14b-latest
LLM_MODELO_EMBEDDINGS=mistral-embed
LLM_TEMPERATURA=0.2
QDRANT_URL=http://qdrant:6333
RAG_K=6
RAG_RERANK=false

# --- Portal web (parte 4) ---
# Clave del cliente `frontend` en la API de acceso, contraseña única del portal y secreto que firma la cookie
ACCESO_CLAVE_FRONTEND=
FRONTEND_CLAVE=
FRONTEND_SECRETO=

# --- Túnel del portal para la web pública (Vercel) ---
# Cuenta gratuita de ngrok: el token está en dashboard.ngrok.com → Your Authtoken, y el dominio fijo gratuito en
# Domains (algo como nombre-aleatorio.ngrok-free.app, sin https://). Se pegan a mano; `make entorno` los deja vacíos.
NGROK_AUTHTOKEN=
NGROK_DOMINIO=

# --- Spark ---
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g

# --- Puertos en el anfitrión (127.0.0.1) ---
PUERTO_S3=8333
PUERTO_MONGO=27018
PUERTO_CAPTURA=8001
PUERTO_ACCESO=8002
PUERTO_SPARK=8090
PUERTO_AIRFLOW=8085
PUERTO_PROMETHEUS=9090
PUERTO_GRAFANA=3000
PUERTO_OLLAMA=11435
PUERTO_CHATBOT=8010
PUERTO_CHATBOT_RAG=8011
PUERTO_QDRANT=6333
PUERTO_FRONTEND=8020
PUERTO_CONSOLA=8088
